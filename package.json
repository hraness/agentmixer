{
  "name": "@hraness/agentmixer",
  "version": "0.1.0",
  "description": "Provider-neutral agent routing, account custody and scoped tool contracts.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/agentmixer.git"
  },
  "homepage": "https://agentmixer.dev",
  "bugs": {
    "url": "https://github.com/hraness/agentmixer/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "MANAGED-CODEX.md"
  ],
  "scripts": {
    "build:dist": "bun scripts/build-dist.ts",
    "check:package": "bun scripts/package-smoke.ts",
    "test": "bun test ./src ./test ./scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "bun run typecheck && bun run test && bun run build:dist && bun run check:package",
    "prepack": "bun run check"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.268",
    "@anthropic-ai/sdk": "0.125.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "sigstore": "4.1.1",
    "typescript": "6.0.3"
  }
}
